# Default local direct-run example.
# For local app execution, copy this file to .env and run bootRun.ps1.
# For Docker Compose, prefer .env.docker.example or .env.server.example.

POS_APP_PORT=8080

# Spring Boot datasource for local direct execution.
POS_DB_URL=jdbc:postgresql://localhost:5432/pos_mk1
POS_DB_NAME=pos_mk1
POS_DB_USERNAME=pos
POS_DB_PASSWORD=pos
POS_DB_BIND=127.0.0.1
POS_DB_PORT=5432
POS_DB_TZ=Asia/Seoul

# Redis for local direct execution.
POS_REDIS_HOST=localhost
POS_REDIS_BIND=127.0.0.1
POS_REDIS_PORT=6379
POS_REDIS_PASSWORD=
POS_REDIS_NAMESPACE=pos:mk1:session
POS_NOTE_LIST_CACHE_KEY_PREFIX=pos:mk1:notes:list:v1:
POS_NOTE_LIST_CACHE_TTL=PT5M

# Elasticsearch is disabled by default.
POS_ELASTICSEARCH_URIS=http://localhost:9200
POS_ELASTICSEARCH_BIND=127.0.0.1
POS_ELASTICSEARCH_PORT=9200
POS_SEARCH_ELASTICSEARCH_ENABLED=false
POS_SEARCH_ELASTICSEARCH_INDEX_NAME=notes-mk1
POS_SEARCH_ELASTICSEARCH_REINDEX_ON_STARTUP=true

# Initial account and JWT settings.
POS_SECURITY_USERNAME=admin@gmail.com
POS_SECURITY_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
POS_SECURITY_ROLE=ROLE_USER
POS_JWT_SECRET=

# AI provider / API keys.
POS_AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_MAX_OUTPUT_TOKENS=4096
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_MAX_TOKENS=8192
